<?xml version="1.0"?>
<sdf version="1.10">
  <!--
    The 48 ft BattleBox.

    What the robots touch is simple shapes: a flat floor with its top at
    z = 0 and four walls whose inner faces are 7.28 m from the centre (where
    the arena model has them). The arena model itself is only drawn. Driving
    on its triangle mesh made the robots bob, slide and catch on edges.
  -->
  <world name="battlebox">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>

    <!-- Defined here, not fetched from the model server: the lab PC is often offline -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="battlebox_scene">
      <static>true</static>

      <link name="link">
        <!-- Drawn only. The mesh's floor surface is 0.45 m above its origin. -->
        <visual name="visual">
          <pose>0 0 -0.45 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <uri>package://nemesis_gazebo/meshes/battlebox.stl</uri>
              <scale>0.005 0.005 0.005</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <collision name="floor">
          <pose>0 0 -0.25 0 0 0</pose>
          <geometry><box><size>15.2 15.2 0.5</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_x_pos">
          <pose>7.53 0 0.5 0 0 0</pose>
          <geometry><box><size>0.5 15.6 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_x_neg">
          <pose>-7.53 0 0.5 0 0 0</pose>
          <geometry><box><size>0.5 15.6 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_y_pos">
          <pose>0 7.53 0.5 0 0 0</pose>
          <geometry><box><size>15.6 0.5 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_y_neg">
          <pose>0 -7.53 0.5 0 0 0</pose>
          <geometry><box><size>15.6 0.5 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <scene>
      <grid>false</grid>
    </scene>
  </world>
</sdf>
