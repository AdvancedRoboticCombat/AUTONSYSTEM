  <!-- ═══════════════════════════════════════════════════════════════════
       Gazebo plugins
       ═══════════════════════════════════════════════════════════════════ -->
  <gazebo>
    <!-- Pose publisher (ground-truth /model/nemesis/pose) -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>200</update_frequency>
    </plugin>
    <!-- Wheel controllers (left = fl + rl via mimic, right = fr + rr via mimic) -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>fl_joint</joint_name>
      <topic>/nemesis/left_wheels/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rl_joint</joint_name>
      <topic>/nemesis/left_wheels/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>fr_joint</joint_name>
      <topic>/nemesis/right_wheels/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rr_joint</joint_name>
      <topic>/nemesis/right_wheels/cmd_vel</topic>
    </plugin>
    <!-- Arm -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>arm_joint</joint_name>
      <topic>/nemesis/arm_motor/cmd_vel</topic>
    </plugin>
    <!-- Weapon spinner -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>spin_joint</joint_name>
      <topic>/nemesis/weapon_motor/cmd_vel</topic>
    </plugin>
  </gazebo>
  <!-- IMU sensor on base_link -->
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="none" />
          </x>
          <y>
            <noise type="none" />
          </y>
          <z>
            <noise type="none" />
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="none" />
          </x>
          <y>
            <noise type="none" />
          </y>
          <z>
            <noise type="none" />
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="fr_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
  </gazebo>
  <gazebo reference="fl_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
  </gazebo>
  <gazebo reference="rr_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
  </gazebo>
  <gazebo reference="rl_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
  </gazebo>
  <gazebo reference="arm_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="spin_link">
    <!-- A spinning disc that grips what it touches launches the robot. A saw cuts and slips. -->
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>
</robot>